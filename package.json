    "pi-package",
    "pi-extension",
    "litellm",
    "girard-davila"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^24",
    "typescript": "^5.6.3"
  }
}
